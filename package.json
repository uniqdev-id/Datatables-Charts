{
    "name": "datatables-chart",
    "version": "1.0.1",
    "description": "A DataTables plugin for creating interactive charts from table data using Chart.js",
    "main": "dist/datatables.charts.min.js",
    "files": [
        "dist/",
        "src/",
        "examples/",
        "README.md",
        "RELEASE.md"
    ],
    "scripts": {
        "lint": "npm run build:dev && eslint dist/datatables.charts.js",
        "lint:fix": "npm run build:dev && eslint dist/datatables.charts.js --fix",
        "build": "mkdir -p dist && concat -o dist/datatables.charts.js src/js/*.js && terser dist/datatables.charts.js -c -m -o dist/datatables.charts.min.js",
        "build:dev": "mkdir -p dist && concat -o dist/datatables.charts.js src/js/*.js",
        "dev": "live-server --open=./examples/",
        "format": "prettier --write \"src/**/*.{js,css}\" \"examples/**/*.{html,js,css}\"",
        "format:check": "prettier --check \"src/**/*.{js,css}\" \"examples/**/*.{html,js,css}\"",
        "prepare": "npm run build",
        "prepublishOnly": "npm run lint && npm run build",
        "release:patch": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major"
    },
    "keywords": [
        "datatables",
        "charts",
        "jquery",
        "chart.js",
        "data-visualization",
        "tables",
        "plugin",
        "javascript"
    ],
    "author": "UNIQ DEV ID",
    "license": "MIT",
    "homepage": "https://github.com/annasblackhat/datatables-chart#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/annasblackhat/datatables-chart.git"
    },
    "bugs": {
        "url": "https://github.com/annasblackhat/datatables-chart/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "peerDependencies": {
        "chart.js": ">=3.0.0",
        "datatables.net": ">=1.10.0",
        "jquery": ">=3.0.0"
    },
    "devDependencies": {
        "concat": "^1.0.3",
        "eslint": "^9.37.0",
        "live-server": "^1.2.2",
        "prettier": "^3.6.2",
        "terser": "^5.44.0"
    },
    "engines": {
        "node": ">=14.0.0",
        "npm": ">=6.0.0"
    }
}
